# Saleor GraphQL endpoint, as the app reaches it and as Saleor reports itself.
# Only this Saleor instance may install the app.
SALEOR_API_URL=http://localhost:8000/graphql/
SALEOR_CHANNEL_SLUG=default-channel

# The app's own database (created by infra/postgres/init-brokerage.sql).
BROKERAGE_DATABASE_URL=postgres://saleor:saleor@localhost:5432/brokerage

# Saleor (in Docker) calls the app here: install handshake and webhooks.
APP_API_BASE_URL=http://host.docker.internal:3000
# The browser loads dashboard pages and widgets from here.
APP_IFRAME_BASE_URL=http://localhost:3000

# Browser origin allowed to post inquiries to /api/public/inquiries.
STOREFRONT_ORIGIN=http://localhost:3001

# Where the install token is stored (FileAPL). Use a persistent volume in production.
APL_FILE_PATH=.saleor-app-auth.json

# Used only by `pnpm provision`.
SALEOR_STAFF_EMAIL=admin@example.com
SALEOR_STAFF_PASSWORD=
SALEOR_DEFAULT_COUNTRY=US
SALEOR_SALES_COUNTRIES=US
